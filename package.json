{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "typegen": "next typegen .",
    "start": "next start",
    "typecoverage": "pnpm dlx type-coverage -at-least=99",
    "depcheck": "pnpm dlx knip",
    "vulcheck": "pnpm dlx is-my-node-vulnerable",
    "metadata": "pnpm dlx check-site-meta 3000",
    "lint": "biome check && echo Lint check finished",
    "lint:write": "biome check --write && echo Lint check finished",
    "typecheck": "tsc --noEmit && echo Typecheck finished",
    "format": "prettier . --write \"**/*.{ts,tsx,js,jsx,json}\" && echo Format check finished"
  },
  "engines": {
    "node": "^22",
    "pnpm": "^10"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "4.1.3",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@react-email/render": "1.2.1",
    "@tabler/icons-react": "3.34.1",
    "botid": "1.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "3.13.0",
    "lenis": "1.3.8",
    "lucide-react": "^0.540.0",
    "next": "15.5.0",
    "next-themes": "0.4.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "7.62.0",
    "resend": "6.0.1",
    "schema-dts": "1.1.5",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "^3.3.1",
    "ua-parser-js": "^1.0.41",
    "vaul": "1.1.2",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "0.5.16",
    "@types/node": "22.17.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ua-parser-js": "0.7.39",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5"
  }
}
