{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "typegen": "next typegen .",
    "start": "next start",
    "typecoverage": "pnpm dlx type-coverage -at-least=99",
    "depcheck": "pnpm dlx knip",
    "vulcheck": "pnpm dlx is-my-node-vulnerable",
    "metadata": "pnpm dlx check-site-meta 3000",
    "lint": "biome check && echo Lint check finished",
    "lint:write": "biome check --write && echo Lint check finished",
    "typecheck": "tsc --noEmit && echo Typecheck finished",
    "format": "prettier . --write \"**/*.{ts,tsx,js,jsx,json}\" && echo Format check finished"
  },
  "engines": {
    "node": "^22",
    "pnpm": "^10"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "4.1.3",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@react-email/render": "1.4.0",
    "@tabler/icons-react": "3.35.0",
    "@vercel/analytics": "1.6.1",
    "botid": "1.5.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "3.14.1",
    "lenis": "1.3.16",
    "next": "16.0.10",
    "next-themes": "0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.62.0",
    "resend": "6.5.2",
    "schema-dts": "1.1.5",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "^3.4.0",
    "ua-parser-js": "1.0.41",
    "vaul": "1.1.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "0.5.19",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/ua-parser-js": "0.7.39",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.7",
      "@types/react-dom": "19.2.3"
    }
  }
}
