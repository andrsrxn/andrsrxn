{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "typegen": "next typegen .",
    "start": "next start",
    "typecoverage": "pnpm dlx type-coverage -at-least=99",
    "depcheck": "pnpm dlx knip",
    "vulcheck": "pnpm dlx is-my-node-vulnerable",
    "metadata": "pnpm dlx check-site-meta 3000",
    "lint": "biome check && echo Lint check finished",
    "lint:write": "biome check --write && echo Lint check finished",
    "typecheck": "tsc --noEmit && echo Typecheck finished",
    "format": "prettier . --write \"**/*.{ts,tsx,js,jsx,json}\" && echo Format check finished",
    "doctor": "pnpm dlx react-doctor@latest ."
  },
  "engines": {
    "node": "^24",
    "pnpm": "^11"
  },
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "@andrsrxn/icons": "5.0.0",
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "5.4.0",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@react-email/render": "1.4.0",
    "@vercel/analytics": "2.0.1",
    "botid": "1.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "3.15.0",
    "lenis": "1.3.23",
    "next": "16.2.6",
    "next-intl": "4.12.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.76.1",
    "resend": "6.12.4",
    "schema-dts": "2.0.0",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "^3.4.0",
    "ua-parser-js": "1.0.41",
    "vaul": "1.1.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "0.5.19",
    "@types/node": "24.12.4",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/ua-parser-js": "0.7.39",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
